{
  "name": "sd-lab-week01-git-practices",
  "version": "1.0.1",
  "description": "Laboratorio Semana 1 - Buenas prácticas en el uso de Git (GitLab/GitHub) con proyecto de prueba en HTML, CSS y JS nativo",
  "main": "src/js/main.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "report": "node scripts/generate-report.js"
  },
  "keywords": [
    "git",
    "gitlab",
    "github",
    "jest",
    "vanilla-js",
    "html",
    "css"
  ],
  "author": "Diego Alejandro Botina",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0",
    "docx": "^9.0.2",
    "image-size": "^1.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/tests"
    ],
    "moduleDirectories": [
      "node_modules",
      "src/js"
    ],
    "collectCoverageFrom": [
      "src/js/**/*.js"
    ]
  }
}